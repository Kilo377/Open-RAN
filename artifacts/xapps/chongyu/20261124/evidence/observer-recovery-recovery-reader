def sha(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()
def digest(value):return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()
def read(path):return json.loads(Path(path).read_text())
def expect(test,message):
    if not test:raise ValueError(message)
def utc(value):
    value=datetime.fromisoformat(value.replace('Z','+00:00'))
    expect(value.tzinfo is not None and value.utcoffset().total_seconds()==0,'UTC evidence required');return value


def confined(root,name):
    name=Path(name);path=root/name
    expect(not name.is_absolute()and '..'not in name.parts and path.resolve().is_relative_to(root.resolve()),'Recovery path escaped case')
    expect(not path.is_symlink()and not any(p.is_symlink()for p in path.parents if p.is_relative_to(root)),'Recovery symlinks rejected')
    return path


def verify_members(root,files):
    expect(isinstance(files,dict)and bool(files),'Recovery seal members missing')
    for name,item in files.items():
        path=confined(root,name)
        expect(path.is_file()and path.stat().st_size==item.get('bytes')and sha(path)==item.get('sha256'),'Recovery sealed bytes differ: '+name)


def verify_archive(archive,members):
    expect(sha(archive)==SOURCE,'Registered c424 archive changed');seen=set();directories=set()
    allowed_dirs=set(KNOWN_DIRECTORY_HEADERS)
    with tarfile.open(archive,'r:*')as stream:
        for item in stream:
            if item.isdir():
                path=Path(item.name);name=str(path)
                expect(not path.is_absolute()and '..'not in path.parts and name in allowed_dirs
                    and name not in directories,'Unconfined or unregistered source directory header')
                directories.add(name);continue
            expect(item.isfile()and item.name not in seen and item.name in members,'Source archive member mismatch')
            data=stream.extractfile(item).read();pin=members[item.name]
            expect(len(data)==pin['bytes']and hashlib.sha256(data).hexdigest()==pin['sha256']and item.mode==pin['mode'],'Source archive bytes differ')
            seen.add(item.name)
    expect(seen==set(members)and len(seen)==1432,'All original1432 source members required')
    expect(directories==allowed_dirs and len(directories)==51,'The exact registered51 directory headers are required')


