        actual_exit_code=None,exit_code_status='unavailable_non_child',original_failed_status_sha256=FAILED_STATUS,
        original_failed_seal_sha256=FAILED_SEAL,failure_envelope_sha256=ENVELOPE,root_go_sha256=ROOT_GO,
        supplemental_seal_sha256=sha(seal_path),recovery_certificate_sha256=sha(cert_path),pid_continuity=continuity,
        source_archive_sha256=SOURCE,model_sha256=MODEL,selection_sha256=SELECTION,validation_lane=lane,evidence_files=evidence_files,
        contiguous_native_slots_verified=last,KPI_extracted=False)
    proof['reader_amendment']=dict(path=str(amendment_path),sha256=sha(amendment_path),**amendment_wanted)
    return dict(status_path=str(rec/'complete-status.json'),seal_path=str(seal_path),audit_path=str(rec/'audit.json'),evidence=proof)
